{
  "type": "object",
  "required": ["version", "tag"],
  "anyOf": [{ "required": ["groups"] }, { "required": ["items"] }],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "tag": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "channel": { "type": "string" },
    "title": { "type": "string" },
    "notice": { "type": "string" },
    "intro": { "type": "string" },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "changed": { "$ref": "#/$defs/entries" },
        "added": { "$ref": "#/$defs/entries" },
        "removed": { "$ref": "#/$defs/entries" },
        "fixed": { "$ref": "#/$defs/entries" }
      }
    },
    "items": { "type": "array", "items": { "type": "string" } },
    "spatialNotes": { "type": "string" }
  },
  "$defs": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "breaking": { "type": "boolean" }
            }
          }
        ]
      }
    }
  }
}
